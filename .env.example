# CloudSentinel environment — copy to .env and fill in. Never commit the real
# .env (it is gitignored). Every value below is optional; the shown default
# applies when the variable is unset.

# --- LLM provider ------------------------------------------------------------
# Gemini API key from a billing-disabled Google Cloud project (free tier).
# Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Force the deterministic fake provider (tests/CI/offline demos). 1/true/yes/on.
SENTINEL_FAKE_LLM=
# Hard per-call transport timeout in seconds (default 30).
SENTINEL_LLM_TIMEOUT_SECONDS=

# --- persistence -------------------------------------------------------------
# SQLite file path (default cloudsentinel.db). Deploy disks are ephemeral;
# the schema rebuilds on every boot (seed-on-startup).
SENTINEL_DB_PATH=
# Hours before an undecided proposal auto-expires on read (default 72; 0 off).
SENTINEL_ACTION_TTL_HOURS=

# --- detection ---------------------------------------------------------------
# zscore (default) | mad
SENTINEL_DETECTOR=
# Rolling baseline window in days (default 28).
SENTINEL_BASELINE_WINDOW_DAYS=
# 1 to opt into day-of-week (seasonal) baselines (default off).
SENTINEL_SEASONAL=

# --- pulse / guardrails ------------------------------------------------------
# Max provider calls per pulse before rule-based fallback (default 14).
SENTINEL_PULSE_LLM_BUDGET=
# Per-IP POST /pulse limit per minute (default 60; 0 disables).
SENTINEL_PULSE_RATE_LIMIT_PER_MINUTE=

# --- analytics / deploy ------------------------------------------------------
# Monthly cost budget; when set, the forecast flags projected overruns.
SENTINEL_MONTHLY_BUDGET=
# Deploy environment label. Set to "render" to light the LIVE banner.
SENTINEL_ENV=

# --- live data ---------------------------------------------------------------
# Cost lane source: "self" serves the app's own request telemetry (live,
# accumulates while the server runs); unset/"mock" serves the bundled fixture.
SENTINEL_COSTS_SOURCE=
# Imported billing export (scripts/import_costs.py output) — the
# credential-free real-data trial. Wins over the feed URL below.
SENTINEL_COSTS_FILE=
# External JSON feeds per lane — each must answer the same shape as its mock
# file in app/data/. When set, the lane goes live; on fetch failure it falls
# back to the last good payload, then to the mock. Explicit
# SENTINEL_COSTS_SOURCE=mock wins over a configured costs feed URL.
SENTINEL_COSTS_FEED_URL=
SENTINEL_SECURITY_FEED_URL=
SENTINEL_FRAUD_FEED_URL=
# Seconds a fetched feed payload stays fresh (default 300; 0 refetches
# every read).
SENTINEL_FEED_TTL_SECONDS=
# 0 disables the self-telemetry request counter (default on).
SENTINEL_SELF_TELEMETRY=

# --- demo operations ----------------------------------------------------------
# 1 shifts every mock dataset forward by whole weeks so the data ends near
# yesterday (weekday alignment preserved). Demo freshness only.
SENTINEL_REBASE_DATES=
# 1 enables POST /ops/demo-reset (clean slate before a rehearsal/jury run).
SENTINEL_DEMO_RESET=
# 1 blocks every POST — a safe read-only public showcase link.
SENTINEL_READONLY=

# --- live ops ----------------------------------------------------------------
# Real notification dispatch: when set, an executed action's incident report is
# POSTed to this webhook (Discord/Slack/n8n style) — infrastructure mutation
# stays simulated. Keep the URL secret; only its host is ever logged or stored.
SENTINEL_EXECUTE_WEBHOOK_URL=
# Live-ops mode — use INSTEAD of SENTINEL_READONLY (readonly blocks ALL writes,
# login included): 1 requires a signed-in approver/admin for approve/reject/
# execute. Reads stay public; self-registration stays open but only mints
# viewers, so strangers can look yet never decide.
SENTINEL_REQUIRE_APPROVER=
# Bootstrap deciding account, created at lifespan startup when missing (an
# existing user is never overwritten; the password is never logged) — how the
# team gets an admin session on an ephemeral-disk deploy.
SENTINEL_ADMIN_USER=
SENTINEL_ADMIN_PASSWORD=

# Boot-default mission (finops | security | fraud); the dashboard quick-switch outranks it.
SENTINEL_MISSION=
# Review-panel model roster, comma-separated (default: gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash).
SENTINEL_PANEL_MODELS=
# 1 = leave-one-out scoring (contamination-resistant z baseline).
SENTINEL_LEAVE_ONE_OUT=
# Login attempts allowed per minute per IP (default 10).
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=
# >0 starts the opt-in watchdog: the sentinel pulses itself on this cadence (seconds, min 30).
SENTINEL_WATCH_INTERVAL_SECONDS=
